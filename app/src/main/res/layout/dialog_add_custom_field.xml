<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvAddFieldHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_custom_field_title"
            android:textColor="?attr/phTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAddFieldCategoryInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/phTextSecondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/custom_field_name_label"
            android:textColor="?attr/phTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field_blue"
            android:hint="@string/custom_field_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="?attr/phTextPrimary"
            android:textColorHint="?attr/phTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_field_default_label"
            android:textColor="?attr/phTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomFieldDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field_blue"
            android:hint="@string/custom_field_default_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="?attr/phTextPrimary"
            android:textColorHint="?attr/phTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_field_type_label"
            android:textColor="?attr/phTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCustomFieldType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rbTypeSingleLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Single Line Text"
                android:textColor="?attr/phTextPrimary"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbTypeMultiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Multiline Text"
                android:textColor="?attr/phTextPrimary"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbTypeNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Number"
                android:textColor="?attr/phTextPrimary"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbTypePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="?attr/phTextPrimary"
                android:textSize="13.5sp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_field_requirement_label"
            android:textColor="?attr/phTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCustomFieldRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFieldRequired"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_required_option"
                android:textColor="?attr/phTextPrimary"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbFieldOptional"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/field_optional_option"
                android:textColor="?attr/phTextPrimary"
                android:textSize="13.5sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvRequiredChoiceError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_select_required_or_optional"
            android:textColor="@color/danger_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelAddField"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="?attr/phTextSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAddField"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save_custom_field"
                android:textColor="@color/white"
                app:backgroundTint="?attr/phAccentBlue"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
