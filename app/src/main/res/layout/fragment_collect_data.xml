<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Swipeable + Clickable 2-Category Tab Switcher -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/categoryTabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/phCardBg"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/blue_primary"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/blue_primary"
        app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall"
        app:tabTextColor="?attr/phTextSecondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/phCardStroke" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/categoryViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
