<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PropertyHub" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/header_navy_start</item>
        <item name="android:windowBackground">@color/canvas_bg</item>

        <item name="phCanvasBg">@color/canvas_bg</item>
        <item name="phCardBg">@color/white</item>
        <item name="phCardStroke">@color/blue_card_stroke</item>
        <item name="phSubtleSurface">@color/subtle_surface_blue</item>
        <item name="phTextPrimary">@color/text_primary</item>
        <item name="phTextSecondary">@color/text_hint</item>
        <item name="phInputBg">@color/white</item>
        <item name="phInputStroke">@color/input_border</item>
        <item name="phNavBg">@color/white</item>
        <item name="phNavBorder">@color/nav_border_light</item>
        <item name="phAccentBlue">@color/blue_primary</item>
    </style>

    <style name="Theme.PropertyHub.Blue" parent="Theme.PropertyHub" />

    <style name="Theme.PropertyHub.Light" parent="Theme.PropertyHub">
        <item name="android:windowBackground">@color/canvas_bg_light</item>
        <item name="phCanvasBg">@color/canvas_bg_light</item>
        <item name="phCardStroke">@color/card_stroke_light</item>
        <item name="phSubtleSurface">@color/subtle_surface_light</item>
    </style>

    <style name="Theme.PropertyHub.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blue_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/header_navy_start</item>
        <item name="android:windowBackground">@color/canvas_bg_dark</item>

        <item name="phCanvasBg">@color/canvas_bg_dark</item>
        <item name="phCardBg">@color/card_bg_dark</item>
        <item name="phCardStroke">@color/card_stroke_dark</item>
        <item name="phSubtleSurface">@color/subtle_surface_dark</item>
        <item name="phTextPrimary">@color/text_primary_dark</item>
        <item name="phTextSecondary">@color/text_secondary_dark</item>
        <item name="phInputBg">@color/input_bg_dark</item>
        <item name="phInputStroke">@color/input_border_dark</item>
        <item name="phNavBg">@color/nav_bg_dark</item>
        <item name="phNavBorder">@color/nav_border_dark</item>
        <item name="phAccentBlue">@color/blue_accent_dark</item>
    </style>
</resources>
